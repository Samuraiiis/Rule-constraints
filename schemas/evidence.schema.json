{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "description": "后处理阶段的单条 Evidence 对象。跨对象引用由 rule_validator.py 检查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "document_id",
    "evidence_type",
    "evidence_statement",
    "source_text",
    "section",
    "page",
    "assertion_type",
    "entities"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "type": "string",
      "minLength": 1
    },
    "evidence_statement": {
      "type": "string",
      "minLength": 1
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "section": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "page": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "assertion_type": {
      "type": "string",
      "enum": [
        "Positive",
        "Negative",
        "Uncertain",
        "Conditional",
        "Comparative",
        "Recommendation",
        "Association",
        "Prediction",
        "Unknown"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
